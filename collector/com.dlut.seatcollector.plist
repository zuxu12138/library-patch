<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dlut.seatcollector</string>

    <!-- 安装前将下方两个占位符替换为本机绝对路径。 -->
    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON_BIN__</string>
        <string>__PROJECT_DIR__/collector/seat_collector.py</string>
        <string>loop</string>
        <string>600</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/tmp/library-patch-seat-collector.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/library-patch-seat-collector-error.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
