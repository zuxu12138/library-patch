# --- 忽略可再生的生成文件 ---
service/target/
service/.mvn/
collector/data/*.db
collector/data/*.db-shm
collector/data/*.db-wal

# --- 忽略本地配置 ---
.env
service/src/main/resources/application-local.yml

# --- 忽略 IDE ---
.idea/
.vscode/
*.iml

# --- 忽略系统文件 ---
.DS_Store

# --- Python ---
.claude/
__pycache__/
*.pyc
*.pyo
